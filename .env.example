# TikTok Shop integration — variable NAMES only. Never put real values here.
# Real values go in .env.local (git-ignored) and in Vercel's environment UI.

# From Partner Center → App & Service → your app → Credentials.
# Use the DEV app's values in Development, the PRODUCTION app's in Production.
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=

# Public identifier of the app (Partner Center → your app → Basic information).
# Not a secret. Used to build the seller authorization link (/api/tiktok/auth/start).
TIKTOK_SERVICE_ID=
# Optional override of the authorize host. Default is the US host
# https://services.us.tiktokshop.com/open/authorize (ROW: services.tiktokshop.com).
# TIKTOK_AUTHORIZE_BASE=

# 32 random bytes, base64:  openssl rand -base64 32
# Server-only. Use a DIFFERENT key per environment (dev / preview / production).
TIKTOK_TOKEN_ENCRYPTION_KEY=

# Optional: send TikTok data to a dedicated Redis instead of the app's.
# TIKTOK_REDIS_URL=
# TIKTOK_REDIS_TOKEN=

# Optional: force the OAuth `state` check on/off. Default: required in
# production/preview, optional in local dev (Partner Center's sandbox
# "Authorize app" button starts the flow without our state).
# TIKTOK_REQUIRE_STATE=
